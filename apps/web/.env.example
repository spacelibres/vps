# shellcheck disable=SC2034
# ── 面板访问密码门 ──────────────────────────────────────────
# 登录面板所需的密码（必填，否则无法登录）
PANEL_PASSWORD=change-me-please

# 签名 session cookie 的密钥（必填，建议 32 字节以上的随机串）
# 生成方式：openssl rand -hex 32
SESSION_SECRET=please-generate-a-long-random-secret

# ── 可选 ────────────────────────────────────────────────────
# KiwiVM API 基地址（默认 https://api.64clouds.com/v1）
# KIWIVM_API_BASE=https://api.64clouds.com/v1

# 相邻两次出站 API 调用的最小间隔（毫秒），用于避免触发限流
# KIWIVM_MIN_INTERVAL_MS=120

# ── IP 池插件（ip-pool，全部可选）─────────────────────────
# Bing 底图图层：Road | Aerial | AerialWithLabels（默认 Road）
# NEXT_PUBLIC_BING_IMAGERY_SET=Road
# Bing Maps Key（不填则直连 Bing 瓦片 CDN）
# NEXT_PUBLIC_BING_MAPS_KEY=
# IP 池文件路径（默认自动查找仓库根的 kh.google.com.yaml）
# IP_POOL_FILE=
# IP 池主机名（默认 kh.google.com）
# IP_POOL_HOSTNAME=kh.google.com
# 统计落盘目录（默认 apps/web/data/ip-stats）
# IP_POOL_DATA_DIR=
# 入口 B：JSONL 事件文件 / 外部统计 YAML
# IP_POOL_EVENTS_FILE=
# IP_POOL_STATS_FILE=

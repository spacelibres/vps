# shellcheck disable=SC2034
# ── 面板访问密码门 ──────────────────────────────────────────
# 登录面板所需的密码（必填，否则无法登录）
PANEL_PASSWORD=change-me-please

# 签名 session cookie 的密钥（必填，建议 32 字节以上的随机串）
# 生成方式：openssl rand -hex 32
SESSION_SECRET=please-generate-a-long-random-secret

# 会话 cookie 是否强制加 Secure（默认按请求协议自适应：HTTPS 加、HTTP 不加）
# 纯 HTTP 部署不要设为 1，否则浏览器会丢弃 cookie，导致「密码对但登录不上」。
# PANEL_COOKIE_SECURE=auto

# ── 可选 ────────────────────────────────────────────────────
# KiwiVM API 基地址（默认 https://api.64clouds.com/v1）
# KIWIVM_API_BASE=https://api.64clouds.com/v1

# 相邻两次出站 API 调用的最小间隔（毫秒），用于避免触发限流
# KIWIVM_MIN_INTERVAL_MS=120

# ── IP 池插件（ip-pool，全部可选）─────────────────────────
# Bing 底图图层：Road | Aerial | AerialWithLabels（默认 Road）
# NEXT_PUBLIC_BING_IMAGERY_SET=Road
# Bing Maps Key（不填则直连 Bing 瓦片 CDN）
# NEXT_PUBLIC_BING_MAPS_KEY=
# IP 池文件路径（默认自动查找 apps/web/config/kh.google.com.yaml）
# IP_POOL_FILE=
# IP 池主机名（默认 kh.google.com）
# IP_POOL_HOSTNAME=kh.google.com
# 抓取目标 URL（默认 https://kh.google.com/rt/earth/PlanetoidMetadata）
# IP_POOL_TARGET_URL=
# 浏览器指纹 profile（默认 chrome_136）
# IP_POOL_BROWSER=chrome_136
# 出站代理（直连不通时必填；例如本地 SOCKS5）
# IP_POOL_PROXY=socks5h://127.0.0.1:20170
# 抓取超时（毫秒，默认 20000）
# IP_POOL_TIMEOUT_MS=20000
# 弹道起点 "lat,lng[,label]"
# IP_POOL_ORIGIN=
# 统计落盘目录（默认 apps/web/data/ip-stats）
# IP_POOL_DATA_DIR=
# 入口 B：JSONL 事件文件 / 外部统计 YAML
# IP_POOL_EVENTS_FILE=
# IP_POOL_STATS_FILE=

# Caddy 反向代理模板 —— 由 deploy/setup-caddy.sh 生成到 /etc/caddy/Caddyfile
#
# 作用：对外用 443（HTTPS，自动申请 Let's Encrypt 证书）→ 转发到本机 __PORT__（面板）。
# 占位符：__DOMAIN__ / __PORT__ / __GLOBAL__
#
# 说明：
#  - 静态资源分级缓存，避免每次访问都回源（尤其是 ip-pool 页面的国旗 PNG）。
#    注意必须用 `header_down`（在 reverse_proxy 内）来**覆盖**上游的 `Cache-Control`；
#    站点级的 `header` 指令会**追加**而非替换，导致出现重复头、按最严格生效（等于没缓存）。
#  - 压缩排除 SSE 流端点，避免缓冲影响实时弹道推送。

__GLOBAL__

__DOMAIN__ {
	# ── 压缩（排除 SSE，避免缓冲）────────────────────────────
	@compressible not path /api/plugins/*/actions/stream
	encode @compressible zstd gzip

	# ── 缓存：带内容哈希的构建产物 → 一年、不可变 ──────────
	@immutable path /_next/static/*
	handle @immutable {
		reverse_proxy 127.0.0.1:__PORT__ {
			header_down Cache-Control "public, max-age=31536000, immutable"
		}
	}

	# ── 缓存：public/ 静态资源（国旗/图标/字体/图片/favicon）→ 30 天 ──
	@assets path_regexp (?i)\.(?:png|jpe?g|gif|svg|webp|avif|ico|woff2?|ttf|otf|eot)$
	handle @assets {
		reverse_proxy 127.0.0.1:__PORT__ {
			header_down Cache-Control "public, max-age=2592000"
		}
	}

	# ── 其余：页面 HTML / API / SSE ──────────────────────────
		# Caddy 自动带上 X-Forwarded-Proto / X-Forwarded-For，应用据此判定 Secure cookie。
		#
		# 上游（Next.js/Node）默认 keepAliveTimeout≈5s，代理复用空闲连接时会与 Node 关闭竞争，
		# 触发 `read ... connection reset by peer` → **502**（高并发 API 下集中出现）。
		# 关掉上游连接复用，每次新建连接，避开该竞争。
		handle {
			reverse_proxy 127.0.0.1:__PORT__ {
				transport http {
					keepalive off
				}
			}
		}
	}
